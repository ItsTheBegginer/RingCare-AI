# --- Ring (Developer Playground token OR a registered app's refresh token) ---
# Playground: copy the access token from the Playground page (expires in ~30 min).
# You can also hot-swap it without restarting:  POST /api/ring/token {"access_token": "..."}
RING_ACCESS_TOKEN=
# Registered app (optional, auto-refreshing):
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# Webhook signature key (HMAC signing key from the Ring portal). Leave empty to skip verification in dev.
RING_HMAC_KEY=
# If Ring has no downloadable clip yet, analyse a local sample clip instead (clearly labelled). true/false
RING_SAMPLE_FALLBACK=true
# Poll Ring for new events every N seconds (0 = off, use the dashboard button instead)
RING_POLL_SECONDS=0
# --- Assessment thresholds (rules-only, no LLM) ---
FALL_STILL_SECONDS=5
SECURITY_MIN_CONFIDENCE=80
# --- Storage: DynamoDB (production) or SQLite (offline/test fallback) ---
STORAGE_BACKEND=sqlite
AWS_REGION=ap-south-1
DDB_EVENTS_TABLE=RingCareEvents
DDB_SETTINGS_TABLE=RingCareSettings
# Optional endpoint for DynamoDB Local / moto (leave blank for real AWS):
DDB_ENDPOINT=
# --- Vision Detector: rekognition (primary) or opencv (fallback) ---
VISION_BACKEND=opencv
REKOGNITION_MAX_FRAMES=6
REKOGNITION_DAILY_CAP=300
REKOGNITION_MIN_CONFIDENCE=50
# --- Notifications & Escalation (Amazon SNS + Multi-Channel) ---
# SNS Topic ARN created via backend/scripts/create_topic.py
SNS_TOPIC_ARN=
# Enabled notification channels (comma-separated): sns, ntfy, telegram
NOTIFY_CHANNELS=sns,ntfy
NOTIFY_MIN_PRIORITY=medium
ESCALATE_AFTER_MIN=5
MAX_REMINDERS=3
DASHBOARD_URL=http://localhost:3000
RESIDENT_NAME=Eleanor Vance
# Optional fallback mobile alert channels:
NTFY_TOPIC=ringcare-alerts
NTFY_BASE_URL=https://ntfy.sh
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Hosting: S3 clip storage (optional, Phase 9) ---
# Set CLIPS_BACKEND=s3 and S3_BUCKET when hosting on EC2/App Runner
# Leave CLIPS_BACKEND=local for local development
CLIPS_BACKEND=local
S3_BUCKET=
S3_REGION=ap-south-1
